# Katavi E-Kilimo — environment template.
# Copy to .env and fill in real values. Never commit .env.

# Core
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info
DISABLE_CRON=false

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/katavi_ekilimo
MONGO_MIN_POOL_SIZE=2
MONGO_MAX_POOL_SIZE=20

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# Cache (optional; memory cache is used when unset)
REDIS_URL=
CACHE_MAX_KEYS=5000

# Media uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_REFUND_URL=
PAYMENT_WEBHOOK_SECRET=
# Legacy name kept during migration; prefer PAYMENT_WEBHOOK_SECRET.
PAYMENT_CALLBACK_SECRET=

# AI assistants
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_API_URL=
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=

# Email
RESEND_API_KEY=
RESEND_FROM=Katavi E-Kilimo <onboarding@resend.dev>
RESEND_REPLY_TO=

# SMS (Africa's Talking; mocked when keys are empty)
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SHORTCODE=
AFRICASTALKING_ENV=sandbox

# Push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# USSD (*384*# style short code handled by Africa's Talking)
USSD_SERVICE_CODE=
USSD_SUPPORT_PHONE=

# Maps
GEOAPIFY_API_KEY=
GOOGLE_MAPS_API_KEY=

# Ops alerts (Slack/Teams webhook for error spikes)
ALERT_WEBHOOK_URL=

# Optional: web client weather proxy URL (used by the Vite build)
VITE_WEATHER_API_URL=
