# Required for the backend to start
MONGODB_URI=
JWT_SECRET=
PORT=5000

# CORS - set to your deployed frontend URL (e.g. https://your-app.vercel.app)
FRONTEND_URL=

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Chatbot (Groq)
GROQ_API_KEY=

# Africa's Talking (SMS/USSD) — leave empty to stay in mock mode
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SHORTCODE=
AFRICASTALKING_ENV=sandbox

# Vision API (AI Crop Disease Detection) — leave empty for mock detection
# OpenRouter (Bearer): VISION_API_URL=https://openrouter.ai/api/v1/chat/completions, VISION_API_KEY=sk-or-v-...
# OpenRouter provider order: OpenRouter -> Gemini -> generic -> mock
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=google/gemini-2.5-flash

# Gemini fallback (free at https://aistudio.google.com/apikey) — optional; used automatically
# if OpenRouter is not configured or fails
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# Web Push (VAPID) — leave empty for mock push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Payment gateway (Mobile Money) — leave empty for mock payments
PAYMENT_API_URL=
PAYMENT_API_KEY=

# Backend
NODE_ENV=development
